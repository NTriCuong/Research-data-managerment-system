# Compose and public endpoints
HTTP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_USER=rdms
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=rdms
DATABASE_URL=postgresql+asyncpg://rdms:change-this-postgres-password@postgres:5432/rdms

# Backend
APP_NAME=Research Data Management System
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://rdms.example.edu"]
FRONTEND_URL=https://rdms.example.edu
SECRET_KEY=replace-with-a-long-random-secret
OTP_SALT=replace-with-a-separate-random-secret
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=7
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION=15
BACKEND_WORKERS=2
BACKUP_DIRECTORY=/app/backups
PG_DUMP_PATH=pg_dump

# Remote Elasticsearch server
ELASTIC_SERVER_IP=10.0.0.20
ELASTIC_CERT_HOSTNAME=es01
ELASTIC_HOST=https://es01:9200
ELASTIC_USERNAME=rdms_backend
RDMS_ELASTIC_PASSWORD=change-this-rdms-backend-password
ELASTIC_CA_CERT_HOST_PATH=./deploy/elasticsearch/certs/ca.crt
ELASTIC_INDEX=rdms_research_objects
ELASTIC_REQUEST_TIMEOUT_SECONDS=10

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Khoa khoa hoc - cong nghe STU
SMTP_USE_TLS=true
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase/service-account.json

OTP_SALT=local-dev-otp-salt-change-me

# Frontend public build variables
NEXT_PUBLIC_API_URL=/
NEXT_PUBLIC_PUBLIC_HOME_BANNER_URL=
NEXT_PUBLIC_COVER_RESEARCH_URL=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_MEASUREMENT_ID=
