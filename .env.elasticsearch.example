# Local development Elasticsearch
ELASTIC_VERSION=8.17.0
ELASTIC_CLUSTER_NAME=rdms-cluster
ELASTIC_BIND_IP=127.0.0.1
ELASTIC_PORT=9200
ELASTIC_CERT_DNS=elasticsearch
ELASTIC_CERT_IP=127.0.0.1

# Authentication and resources
ELASTIC_PASSWORD=change-this-elastic-password
KIBANA_PASSWORD=change-this-kibana-password
RDMS_ELASTIC_PASSWORD=change-this-rdms-backend-password

# Index
ELASTIC_INDEX=rdms_research_objects_v1
ELASTIC_ALIAS=rdms_research_objects

# Kibana is local-only by default; use an SSH tunnel for administration
KIBANA_BIND_IP=127.0.0.1
KIBANA_PORT=5601
