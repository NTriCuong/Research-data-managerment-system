              }
            }
          },
          "author_order": {
            "type": "short"
          },
          "author_role": {
            "type": "keyword"
          }
        }
      },
      "keywords": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "id": {
            "type": "keyword"
          },
          "text": {
            "type": "text",
            "analyzer": "rdms_english",
            "copy_to": "search_text",
            "fields": {
              "accent": {
                "type": "text",
                "analyzer": "rdms_vietnamese_accent"
              },
              "exact": {
                "type": "keyword",
                "normalizer": "rdms_keyword_normalizer",
                "ignore_above": 256
              }
            }
          },
          "normalized_text": {
            "type": "keyword",
            "normalizer": "rdms_keyword_normalizer",
            "ignore_above": 256
          }
        }
      },
      "domains": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "id": {
            "type": "keyword"
          },
          "code": {
            "type": "keyword",
            "normalizer": "rdms_keyword_normalizer"
          },
          "name": {
            "type": "text",
            "analyzer": "rdms_english",
            "copy_to": "search_text",
            "fields": {
              "accent": {
                "type": "text",
                "analyzer": "rdms_vietnamese_accent"
              },
              "exact": {
                "type": "keyword",
                "normalizer": "rdms_keyword_normalizer",
                "ignore_above": 256
              }
            }
